cabal-version:       >=1.10
name:                lab3
version:             0.1.0.0
build-type:          Simple
license:             MIT
license-file:        LICENSE
author:              Yaroslav Gaiderov
maintainer:          yaroslavgaiderov@mail.ru

library
  hs-source-dirs:      src
  exposed-modules:     Lab3, Linear, Cubic
  build-depends:       base >=4.14 && <5
  default-language:    Haskell2010

executable lab3
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       base >=4.14 && <5
                     , lab3
  default-language:    Haskell2010

test-suite Lab3-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  build-depends:       base >=4.14 && <5
                     , lab3
                     , hspec >=2.9
                     , QuickCheck >=2.14
  default-language:    Haskell2010
